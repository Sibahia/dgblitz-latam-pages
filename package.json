{
  "name": "dgblitz-latam-pages",
  "private": true,
  "version": "0.1.1",
  "description": "Guía y calculadora de talentos de Dungeon Blitz (2012), en español e inglés.",
  "license": "GPL-3.0-only",
  "homepage": "https://sibahia.github.io/dgblitz-latam-pages/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sibahia/dgblitz-latam-pages.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:check": "node scripts/optimize-assets.mjs --check",
    "assets:check:dist": "node scripts/check-dist-assets.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm assets:check && pnpm build && pnpm assets:check:dist"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "i18next": "^26.5.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
